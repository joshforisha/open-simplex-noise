{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "module": "nodenext",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "lib",
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "target": "ES2022"
  },
  "exclude": ["**/*_test.ts"],
  "include": ["src/*.ts"]
}
